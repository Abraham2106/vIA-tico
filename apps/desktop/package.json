{
  "name": "@viaticocero/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "author": "ViáticoCero",
  "description": "Liquidación de viáticos local-first. La IA interpreta; el código autoriza.",
  "homepage": "https://github.com/Abraham2106/vIA-tico",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abraham2106/vIA-tico.git"
  },
  "scripts": {
    "dev:web": "vite --config vite.config.ts",
    "build:web": "vite build --config vite.config.ts",
    "preview:web": "vite preview --config vite.config.ts --host 127.0.0.1 --port 4173",
    "dev": "electron-vite dev -- --no-sandbox",
    "build": "electron-vite build",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64 --x64",
    "typecheck": "tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@carbon/grid": "^11.62.0",
    "@carbon/ibm-products": "^2.98.0",
    "@carbon/icons-react": "^11.88.0",
    "@carbon/layout": "^11.59.0",
    "@carbon/motion": "^11.52.0",
    "@carbon/react": "^1.116.0",
    "@carbon/themes": "^11.81.0",
    "@carbon/type": "^11.67.0",
    "@ibm/plex": "^6.4.1",
    "@qvac/sdk": "0.18.2",
    "@viaticocero/contracts": "0.1.0",
    "@viaticocero/core": "0.1.0",
    "@viaticocero/ui-tokens": "0.1.0",
    "classnames": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^19.3.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.3.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
