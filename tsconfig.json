{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["vitest/globals", "node"],
    "paths": {
      "@viaticocero/contracts": ["./packages/contracts/index.ts"],
      "@viaticocero/core": ["./packages/core/index.ts"],
      "@viaticocero/ui-tokens": ["./packages/ui-tokens/index.ts"]
    }
  },
  "include": [
    "packages/contracts/**/*.ts",
    "packages/core/**/*.ts",
    "packages/ui-tokens/**/*.ts",
    "tests/**/*.ts"
  ]
}
